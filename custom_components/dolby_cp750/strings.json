    "step": {
      "user": {
        "title": "Dolby CP750",
        "description": "Connect to the ASCII control port of a Dolby CP750 cinema processor. With SNMP the integration also shows input signal status, bitstream format, decode mode, output relays and meters.",
        "data": {
          "host": "Host",
          "port": "Port",
          "snmp_enabled": "Use SNMP",
          "snmp_community": "SNMP community"
        },
        "data_description": {
          "host": "IP address or host name of the CP750.",
          "port": "TCP port of the ASCII control interface. The CP750 uses 61408.",
          "snmp_enabled": "Read the status objects of the CP750 MIB over SNMP (UDP port 161).",
          "snmp_community": "Read community of the SNMP agent, usually public."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Dolby CP750",
        "description": "Change the address or the SNMP settings of this CP750.",
